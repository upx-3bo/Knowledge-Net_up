al){
  filterLevel = val === '' ? '' : parseInt(val);
  // 清空其他高亮态
  selectedId = null; neighborSet = new Set();
  searchTerm = ''; searchMatchSet = new Set();
  document.getElementById('searchBox').value = '';
}

// 布局模式切换
function setMode(m){
  layoutMode = m;
  const bf = document.getElementById('btnForce');
  const bs = document.getElementById('btnStatic');
  if (m === 'force'){
    physicsOn = true;
    if (settleTimer) { clearTimeout(settleTimer); settleTimer = null; }
    bf.classList.add('active'); bs.classList.remove('active');
  } else {
    physicsOn = true;  // 先拉伸使其稳定
    if (settleTimer) clearTimeout(settleTimer);
    settleTimer = setTimeout(()=>{ physicsOn = false; }, 2500);
    bs.classList.add('active'); bf.classList.remove('active');
  }
}

async function showDetail(vid){
  const title = document.getElementById('dTitle');
  const body = document.getElementById('dBody');
  const detail = document.getElementById('detail');
  const backdrop = document.getElementById('backdrop');
  title.textContent = '加载中…';
  detail.classList.add('open'); backdrop.style.display='block';
  try {
    const res = await fetch('/graph/node/' + encodeURIComponent(vid));
    const d = await res.json();
    if (d.error) { body.innerHTML = '<div class="empty">未找到该节点</div>'; return; }

    title.textContent = d.label;
    let html = '<span class="dtag" style="background:' + d.color + '">' + esc(d.tag_name) + '</span>';
    html += '<div class="kv"><b>ID</b><span>' + esc(d.vid) + '</span></div>';
    html += '<div class="kv"><b>层级</b><span>level ' + d.level + '（球半径=' + radiusForLevel(d.level) + '）</span></div>';
    for (const [k, v] of Object.entries(d.props)) {
      if (v === null || v === undefined || v === '' || k === 'level') continue;
      html += '<div class="kv"><b>' + esc(k) + '</b><span>' + esc(v) + '</span></div>';
    }

    // 关联（向外）—— 每条带删除按钮 + 备注显示/编辑
    if (d.out_relations.length > 0) {
      html += '<h4>关联（向外）</h4>';
      for (const r of d.out_relations) {
        html += '<div class="rel-row" style="margin:4px 0;padding:6px 8px;background:#f7f8fa;border-radius:6px;">';
        html += '<div class="rel" data-vid="' + esc(r.target_vid) + '" style="display:flex;align-items:center;cursor:pointer;">'
          + '<b>→</b><span class="rtype">' + esc(r.relation_name) + '</span>'
          + '<span class="rnode">' + esc(r.target_label) + '</span>'
          + '<span class="rtype" style="color:#999">(' + esc(r.target_type_name) + ')</span></div>';
        html += '<div style="display:flex;align-items:center;margin-top:3px;gap:4px;">';
        html += '<input type="text" class="edgeRemark" value="' + esc(r.edge_remark) + '" placeholder="连线备注…" '
          + 'data-src="' + esc(r.src_vid) + '" data-dst="' + esc(r.dst_vid) + '" data-etype="' + esc(r.edge_type) + '" style="flex:1;font-size:11px;padding:3px 6px;"/>';
        html += '<button class="edgeSaveBtn" data-src="' + esc(r.src_vid) + '" data-dst="' + esc(r.dst_vid) + '" data-etype="' + esc(r.edge_type) + '" style="font-size:10px;padding:2px 6px;background:#27AE60;color:#fff;border:none;border-radius:3px;cursor:pointer;">存</button>';
        html += '<button class="edgeDelBtn" data-src="' + esc(r.src_vid) + '" data-dst="' + esc(r.dst_vid) + '" data-etype="' + esc(r.edge_type) + '" style="font-size:10px;padding:2px 6px;background:#C0392B;color:#fff;border:none;border-radius:3px;cursor:pointer;">删</button>';
        html += '</div></div>';
      }
    }
    if (d.in_relations.length > 0) {
      html += '<h4>被引用（指向本节点）</h4>';
      for (const r of d.in_relations) {
        html += '<div class="rel-row" style="margin:4px 0;padding:6px 8px;background:#f7f8fa;border-radius:6px;">';
        html += '<div class="rel" data-vid="' + esc(r.target_vid) + '" style="display:flex;align-items:center;cursor:pointer;">'
          + '<b>←</b><span class="rtype">' + esc(r.relation_name) + '</span>'
          + '<span class="rnode">' + esc(r.target_label) + '</span>'
          + '<span class="rtype" style="color:#999">(' + esc(r.target_type_name) + ')</span></div>';
        html += '<div style="display:flex;align-items:center;margin-top:3px;gap:4px;">';
        html += '<input type="text" class="edgeRemark" value="' + esc(r.edge_remark) + '" placeholder="连线备注…" '
          + 'data-src="' + esc(r.src_vid) + '" data-dst="' + esc(r.dst_vid) + '" data-etype="' + esc(r.edge_type) + '" style="flex:1;font-size:11px;padding:3px 6px;"/>';
        html += '<button class="edgeSaveBtn" data-src="' + esc(r.src_vid) + '" data-dst="' + esc(r.dst_vid) + '" data-etype="' + esc(r.edge_type) + '" style="font-size:10px;padding:2px 6px;background:#27AE60;color:#fff;border:none;border-radius:3px;cursor:pointer;">存</button>';
        html += '<button class="edgeDelBtn" data-src="' + esc(r.src_vid) + '" data-dst="' + esc(r.dst_vid) + '" data-etype="' + esc(r.edge_type) + '" style="font-size:10px;padding:2px 6px;background:#C0392B;color:#fff;border:none;border-radius:3px;cursor:pointer;">删</button>';
        html += '</div></div>';
      }
    }
    if (d.out_relations.length === 0 && d.in_relations.length === 0) {
      html += '<h4>关联</h4><div class="empty">暂无关联</div>';
    }

    // ===== 添加关联 =====
    html += '<h4>➕ 添加关联</h4>';
    html += '<div class="kv"><b>目标节点</b><input type="text" id="addEdgeTarget" placeholder="输入目标节点名称或ID" style="flex:1"/></div>';
    let etOpts = '';
    for (const [et, nm] of Object.entries(d.all_edge_types || {})) {
      etOpts += '<option value="' + et + '">' + nm + ' (' + et + ')</option>';
    }
    html += '<div class="kv"><b>关系类型</b><select id="addEdgeType" style="flex:1">' + etOpts + '</select></div>';
    html += '<div class="kv"><b>连线备注</b><input type="text" id="addEdgeRemark" placeholder="可选备注" style="flex:1"/></div>';
    html += '<button class="save-btn" id="dAddEdgeBtn" data-vid="' + esc(d.vid) + '" style="background:#2C5F8A;">添加连线</button>';

    // ===== 编辑区：名称 / 层级 / 支撑材料类型（仅level=0） =====
    html += '<h4>✏️ 编辑节点</h4>';
    html += '<div class="kv"><b>名称</b><input type="text" id="editLabel" value="' + esc(d.label) + '" style="flex:1"/></div>';
    html += '<div class="kv"><b>层级</b><input type="number" id="editLevel" value="' + d.level + '" min="0" max="20" style="flex:1" title="数字越小层级越高（1=最顶层最大），0=支撑材料（最小）" oninput="onEditLevelPreview(this.value)"/></div>';
    html += '<div class="note-tip">层级说明：1=最顶层概括（最大球），2=子领域，3+ =更细技术点，0=支撑材料（最小球）</div>';
    // 仅 level=0 时显示支撑材料类型选择
    html += '<div id="materialRow" style="display:' + (d.level===0?'block':'none') + ';">';
    html += '<div class="kv"><b>材料类型</b><select id="editMaterial" style="flex:1" onchange="onMaterialChange(this.value)">';
    // 判断当前是否为自定义类型（不在固定 4 种内）
    const curMt = d.material_type || '';
    const isCustom = curMt && !['paper','patent','news','doc'].includes(curMt);
    for (const [mt, info] of Object.entries(d.all_materials || {})) {
      html += '<option value="' + mt + '"' + (mt === curMt ? ' selected' : '') + '>' + info.name + '</option>';
    }
    html += '<option value="__custom__"' + (isCustom ? ' selected' : '') + '>自定义…</option>';
    html += '</select></div>';
    // 自定义输入框
    html += '<div id="customMaterialRow" style="display:' + (isCustom ? 'block' : 'none') + ';margin-top:4px;">';
    html += '<input type="text" id="customMaterial" value="' + (isCustom ? esc(curMt) : '') + '" placeholder="输入自定义材料类型名称" style="width:100%;padding:4px 8px;"/>';
    html += '</div>';
    html += '<div class="note-tip">支撑材料按类型着浅色（论文/专利/新闻资讯/公司技术文件/自定义）</div>';
    html += '</div>';

    // ===== 备注 + 链接 =====
    const notes = d.notes || { remarks: '', links: '', updated_at: null };
    html += '<h4>📝 备注</h4>';
    html += '<textarea id="dRemarks" rows="6" placeholder="填写本节点的备注信息…" style="min-height:120px;">' + esc(notes.remarks) + '</textarea>';
    html += '<h4>🔗 链接</h4>';
    html += '<input type="text" id="dLinks" placeholder="相关链接（多个用换行或逗号分隔）" value="' + esc(notes.links) + '"/>';
    // 已有链接的跳转按钮
    if (notes.links && notes.links.trim()){
      const rawLinks = notes.links.replace(new RegExp('[' + String.fromCharCode(10) + String.fromCharCode(13) + ']+', 'g'), ',').split(',');
      const linkList = rawLinks.map(s => s.trim()).filter(u => u && (u.startsWith('http://') || u.startsWith('https://')));
      if (linkList.length > 0){
        html += '<div style="margin-top:4px;">';
        for (const url of linkList){
          html += '<div class="link-row"><a class="link-jump" href="' + esc(url) + '" target="_blank" rel="noopener">跳转 →</a><span style="font-size:11px;color:#666;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;">' + esc(url) + '</span></div>';
        }
        html += '</div>';
      }
    }
    html += '<button class="save-btn" id="dEditBtn" data-vid="' + esc(d.vid) + '">保存修改</button>';
    if (notes.updated_at) {
      html += '<div class="note-tip">备注上次更新：' + esc(notes.updated_at) + '</div>';
    } else {
      html += '<div class="note-tip">尚未填写备注</div>';
    }
    // 删除节点按钮
    html += '<div style="margin-top:16px;border-top:1px solid #eee;padding-top:12px;">';
    html += '<button class="del-btn" id="dDelBtn" data-vid="' + esc(d.vid) + '" data-label="' + esc(d.label) + '" style="background:#C0392B;color:#fff;border:none;padding:6px 14px;border-radius:4px;cursor:pointer;font-size:12px;width:100%;">🗑 删除此节点</button>';
    html += '<div class="note-tip" style="color:#C0392B;">删除后不可恢复，所有相关连线也会一并删除</div>';
    html += '</div>';

    body.innerHTML = html;
  } catch(e) {
    body.innerHTML = '<div class="empty">加载失败：' + esc(e.message) + '</div>';
  }
}

// 详情面板内点击关联节点 → 切换高亮 + 加载该节点详情（事件委托）
document.addEventListener('click', function(ev){
  // 删除连线
  const delBtn = ev.target.closest ? ev.target.closest('.edgeDelBtn') : null;
  if (delBtn) { deleteEdgeAction(delBtn); return; }
  // 保存连线备注
  const edgeBtn = ev.target.closest ? ev.target.closest('.edgeSaveBtn') : null;
  if (edgeBtn) { saveEdgeRemark(edgeBtn); return; }
  // 添加连线
  const addBtn = ev.target.closest ? ev.target.closest('#dAddEdgeBtn') : null;
  if (addBtn) { addEdgeAction(addBtn); return; }
  // 点击关联项 → 跳转
  const el = ev.target.closest ? ev.target.closest('.rel') : null;
  if (el && el.getAttribute('data-vid')) {
    const vid = el.getAttribute('data-vid');
    selectNode(vid);
    showDetail(vid);
    return;
  }
  // 保存节点修改
  const btn = ev.target.closest ? ev.target.closest('#dEditBtn') : null;
  if (btn && btn.getAttribute('data-vid')) {
    saveEdit(btn);
    return;
  }
  // 删除节点
  const delNodeBtn = ev.target.closest ? ev.target.closest('#dDelBtn') : null;
  if (delNodeBtn && delNodeBtn.getAttribute('data-vid')) {
    deleteNodeAction(delNodeBtn);
    return;
  }
});

async function deleteNodeAction(btn){
  const vid = btn.getAttribute('data-vid');
  const label = btn.getAttribute('data-label') || vid;
  if (!confirm('确认删除节点「' + label + '」？' + String.fromCharCode(10) + String.fromCharCode(10) + '删除后不可恢复，所有相关连线也会一并删除。')) return;
  btn.textContent = '删除中…'; btn.disabled = true;
  try {
    const res = await fetch('/graph/node/' + encodeURIComponent(vid), { method: 'DELETE' });
    const d = await res.json();
    if (d.ok){
      closeDetail();
      setTimeout(()=>{ load(); }, 500);
    } else {
      alert('删除失败：' + (d.error || ''));
      btn.textContent = '🗑 删除此节点'; btn.disabled = false;
    }
  } catch(e){
    alert('删除失败：' + e.message);
    btn.textContent = '🗑 删除此节点'; btn.disabled = false;
  }
}

async function deleteEdgeAction(btn){
  const src = btn.getAttribute('data-src');
  const dst = btn.getAttribute('data-dst');
  const etype = btn.getAttribute('data-etype');
  if (!confirm('确认删除这条连线？')) return;
  try {
    const res = await fetch('/graph/edge/delete', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({src_vid:src, dst_vid:dst, edge_type:etype})
    });
    const d = await res.json();
    if (d.ok){
      // 本地移除该 link
      links = links.filter(l => !((l.source.id===src && l.target.id===dst) || (l.source.id===dst && l.target.id===src)));
      // 重新加载详情
      const curVid = document.getElementById('dEditBtn');
      if (curVid) showDetail(curVid.getAttribute('data-vid'));
    } else { alert('删除失败'); }
  } catch(e){ alert('删除失败：'+e.message); }
}

async function saveEdgeRemark(btn){
  const src = btn.getAttribute('data-src');
  const dst = btn.getAttribute('data-dst');
  const etype = btn.getAttribute('data-etype');
  // 找同行的 input
  const row = btn.parentElement;
  const input = row.querySelector('.edgeRemark');
  const remark = input ? input.value : '';
  btn.textContent='…'; btn.disabled=true;
  try {
    const res = await fetch('/graph/edge/edit', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({src_vid:src, dst_vid:dst, edge_type:etype, remark:remark})
    });
    const d = await res.json();
    if (d.ok){
      // 更新本地 link 的 remark
      for (const l of links){
        if ((l.source.id===src && l.target.id===dst)){
          l.remark = remark;
        }
      }
      btn.textContent='存✓';
      setTimeout(()=>{ btn.textContent='存'; btn.disabled=false; }, 1000);
    } else { btn.textContent='存'; btn.disabled=false; alert('保存失败'); }
  } catch(e){ btn.textContent='存'; btn.disabled=false; alert('保存失败：'+e.message); }
}

async function addEdgeAction(btn){
  const srcVid = btn.getAttribute('data-vid');
  const targetInput = document.getElementById('addEdgeTarget');
  const etypeSel = document.getElementById('addEdgeType');
  const remarkInput = document.getElementById('addEdgeRemark');
  let targetVid = (targetInput.value || '').trim();
  const etype = etypeSel.value;
  const remark = remarkInput.value;
  if (!targetVid){ alert('请输入目标节点名称或ID'); return; }
  // 尝试精确匹配 ID，否则按 label 模糊匹配
  let found = null;
  for (const n of nodes){
    if (n.id === targetVid || n.label === targetVid){ found = n.id; break; }
  }
  if (!found){
    const lower = targetVid.toLowerCase();
    for (const n of nodes){
      if (n.label.toLowerCase().indexOf(lower) >= 0 || n.id.toLowerCase().indexOf(lower) >= 0){ found = n.id; break; }
    }
  }
  if (!found){ alert('未找到匹配的节点，请确认名称或ID'); return; }
  btn.textContent='添加中…'; btn.disabled=true;
  try {
    const res = await fetch('/graph/edge/add', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({src_vid:srcVid, dst_vid:found, edge_type:etype, remark:remark})
    });
    const d = await res.json();
    if (d.ok){
      // 本地添加 link
      const idmap = {}; nodes.forEach(n => idmap[n.id] = n);
      if (idmap[srcVid] && idmap[found]){
        links.push({source:idmap[srcVid], target:idmap[found], label:etype, remark:remark});
      }
      btn.textContent='已添加 ✓';
      setTimeout(()=>{ btn.textContent='添加连线'; btn.disabled=false; showDetail(srcVid); }, 1000);
    } else { btn.textContent='添加连线'; btn.disabled=false; alert(d.error || '添加失败'); }
  } catch(e){ btn.textContent='添加连线'; btn.disabled=false; alert('添加失败：'+e.message); }
}

// 编辑层级时预览：level=0 显示材料类型行
function onEditLevelPreview(val){
  const row = document.getElementById('materialRow');
  if (row) row.style.display = (parseInt(val)===0) ? 'block' : 'none';
}

// 材料类型下拉切换：选"自定义…"时显示输入框
function onMaterialChange(val){
  const customRow = document.getElementById('customMaterialRow');
  if (customRow) customRow.style.display = (val === '__custom__') ? 'block' : 'none';
}

async function saveEdit(btn){
  const vid = btn.getAttribute('data-vid');
  const label = document.getElementById('editLabel').value;
  const level = parseInt(document.getElementById('editLevel').value) || 0;
  const remarks = document.getElementById('dRemarks').value;
  const links = document.getElementById('dLinks').value;
  const matSel = document.getElementById('editMaterial');
  let material_type = '';
  if (level === 0 && matSel){
    if (matSel.value === '__custom__'){
      const customInput = document.getElementById('customMaterial');
      material_type = (customInput && customInput.value.trim()) ? customInput.value.trim() : 'doc';
    } else {
      material_type = matSel.value;
    }
  }
  btn.textContent = '保存中…'; btn.disabled = true;
  try {
    const res = await fetch('/graph/node/' + encodeURIComponent(vid) + '/edit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ label: label, level: level, material_type: material_type, remarks: remarks, links: links })
    });
    const d = await res.json();
    if (d.ok) {
      btn.textContent = '已保存 ✓，刷新图中…';
      // 更新本地 nodes 的半径/层级/颜色，立即生效
      for (const n of nodes){
        if (n.id === vid){
          n.r = radiusForLevel(level);
          n.level = level;
          n.label = label;
          n.material_type = material_type;
          // 颜色：level>=1 按层级，level=0 按材料类型
          if (level >= 1){
            n.color = (COLORS['level_' + level]) || '#5aa5e0';
          } else {
            // 自定义类型用灰色，已知类型用对应色
            n.color = COLORS[material_type] || '#B0B0B0';
          }
        }
      }
      // 刷新层级筛选下拉 + 图例（编辑后可能新增层级/材料类型）
      refreshLevelFilter(nodes);
      renderLegend();
      setTimeout(()=>{ btn.textContent = '保存修改'; btn.disabled = false; showDetail(vid); }, 1200);
    } else {
      btn.textContent = '保存失败'; btn.disabled = false;
    }
  } catch(e) {
    btn.textContent = '保存失败'; btn.disabled = false;
  }
}

function closeDetail(){
  document.getElementById('detail').classList.remove('open');
  document.getElementById('backdrop').style.display='none';
}

// ===== 手动添加节点 =====
function openAddNode(){
  const title = document.getElementById('dTitle');
  const body = document.getElementById('dBody');
  const detail = document.getElementById('detail');
  const backdrop = document.getElementById('backdrop');
  title.textContent = '＋ 添加新节点';
  detail.classList.add('open'); backdrop.style.display='block';

  // 若当前有选中节点，默认作为父节点
  const parentVid = selectedId || '';
  const parentLabel = parentVid ? (nodes.find(n=>n.id===parentVid)||{}).label : '';

  let html = '<div class="empty" style="margin-bottom:10px;">填写以下信息创建新节点。若选中了某节点，可自动连线为父子关系。</div>';
  html += '<h4>📝 基本信息</h4>';
  html += '<div class="kv"><b>名称</b><input type="text" id="addLabel" placeholder="节点名称（必填）" style="flex:1"/></div>';
  html += '<div class="kv"><b>层级</b><input type="number" id="addLevel" value="2" min="0" max="20" style="flex:1" title="1=最顶层，2=子领域，3+=更细技术点，0=支撑材料" oninput="onAddLevelPreview(this.value)"/></div>';
  html += '<div class="note-tip">层级说明：1=最顶层概括（最大球），2=子领域，3+ =更细技术点，0=支撑材料（最小球）</div>';
  // 材料类型（仅 level=0）
  html += '<div id="addMaterialRow" style="display:none;">';
  html += '<div class="kv"><b>材料类型</b><select id="addMaterial" style="flex:1" onchange="onAddMaterialChange(this.value)">';
  html += '<option value="paper">论文</option>';
  html += '<option value="patent">专利</option>';
  html += '<option value="news">新闻资讯</option>';
  html += '<option value="doc">公司技术文件</option>';
  html += '<option value="__custom__">自定义…</option>';
  html += '</select></div>';
  html += '<div id="addCustomMaterialRow" style="display:none;margin-top:4px;">';
  html += '<input type="text" id="addCustomMaterial" placeholder="输入自定义材料类型名称" style="width:100%;padding:4px 8px;"/>';
  html += '</div>';
  html += '<div class="note-tip">支撑材料按类型着浅色</div>';
  html += '</div>';
  // 备注 + 链接
  html += '<h4>📝 备注</h4>';
  html += '<textarea id="addRemarks" rows="3" placeholder="备注信息（选填）…" style="width:100%;"></textarea>';
  html += '<h4>🔗 链接</h4>';
  html += '<input type="text" id="addLinks" placeholder="相关链接（选填）" style="width:100%;"/>';
  // 父节点连线
  html += '<h4>🔗 自动连线到父节点（选填）</h4>';
  html += '<div class="kv"><b>父节点</b><input type="text" id="addParentVid" value="' + esc(parentVid) + '" placeholder="父节点 ID（可留空）" style="flex:1"/></div>';
  if (parentLabel){
    html += '<div class="note-tip">当前选中：' + esc(parentLabel) + '（' + esc(parentVid) + '）</div>';
  }
  html += '<div class="kv" style="margin-top:4px;"><b>关系类型</b><select id="addEdgeType" style="flex:1">';
  for (const [et, name] of Object.entries(EDGE_LABELS || {})) {
    html += '<option value="' + et + '">' + name + '</option>';
  }
  html += '</select></div>';
  // AI 帮助建立联系
  html += '<h4>🤖 AI 帮助建立联系（选填）</h4>';
  html += '<label style="font-size:13px;display:flex;align-items:center;gap:6px;"><input type="checkbox" id="addAIRelate" ' + (parentVid ? '' : 'checked') + '/> 创建后用 AI 分析备注，自动建立与现有节点的关联</label>';
  html += '<div class="note-tip">勾选后，AI 会根据节点名称和备注内容，在知识库中寻找相关节点并自动连线（约 10-30 秒）</div>';
  html += '<button class="save-btn" id="addNodeBtn" onclick="submitAddNode(this)" style="margin-top:12px;background:#27AE60;">创建节点</button>';
  html += '<div id="addResult" style="margin-top:8px;"></div>';
  body.innerHTML = html;
}

function onAddLevelPreview(val){
  const row = document.getElementById('addMaterialRow');
  if (row) row.style.display = (parseInt(val)===0) ? 'block' : 'none';
}
function onAddMaterialChange(val){
  const customRow = document.getElementById('addCustomMaterialRow');
  if (customRow) customRow.style.display = (val === '__custom__') ? 'block' : 'none';
}

async function submitAddNode(btn){
  const label = document.getElementById('addLabel').value.trim();
  if (!label){ document.getElementById('addResult').innerHTML = '<span style="color:#C0392B;">名称不能为空</span>'; return; }
  const level = parseInt(document.getElementById('addLevel').value) || 0;
  const remarks = document.getElementById('addRemarks').value;
  const links = document.getElementById('addLinks').value;
  const parent_vid = document.getElementById('addParentVid').value.trim();
  const edge_type = document.getElementById('addEdgeType').value;
  let material_type = '';
  if (level === 0){
    const mtSel = document.getElementById('addMaterial');
    if (mtSel.value === '__custom__'){
      const ci = document.getElementById('addCustomMaterial');
      material_type = (ci && ci.value.trim()) ? ci.value.trim() : 'doc';
    } else {
      material_type = mtSel.value;
    }
  }
  btn.textContent = '创建中…'; btn.disabled = true;
  try {
    const res = await fetch('/graph/node/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ label: label, level: level, material_type: material_type, remarks: remarks, links: links, parent_vid: parent_vid, edge_type: edge_type })
    });
    const d = await res.json();
    if (d.ok){
      // 检查是否需要 AI 帮助建立联系
      const aiRelate = document.getElementById('addAIRelate');
      if (aiRelate && aiRelate.checked){
        document.getElementById('addResult').innerHTML = '<span style="color:#27AE60;">已创建 ✓（ID: ' + esc(d.vid) + '），正在用 AI 分析关联…</span>';
        try {
          const relRes = await fetch('/api/relate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ vid: d.vid })
          });
          const relData = await relRes.json();
          if (relData.ok && relData.relations_created && relData.relations_created.length > 0){
            let relHtml = '<span style="color:#27AE60;">已创建 ✓，AI 建立了 ' + relData.relations_created.length + ' 条关联：</span><br>';
            for (const r of relData.relations_created){
              relHtml += '<span style="font-size:11px;color:#666;">→ ' + esc(r.name) + ' (' + esc(r.edge_type) + ')</span><br>';
            }
            relHtml += '<span style="color:#8E44AD;">正在刷新图谱…</span>';
            document.getElementById('addResult').innerHTML = relHtml;
          } else {
            document.getElementById('addResult').innerHTML = '<span style="color:#27AE60;">已创建 ✓，AI 未找到合适关联</span>';
          }
        } catch(e2){
          document.getElementById('addResult').innerHTML = '<span style="color:#27AE60;">已创建 ✓，AI 关联失败：' + esc(e2.message) + '</span>';
        }
        setTimeout(()=>{ load(); closeDetail(); }, 2000);
      } else {
        document.getElementById('addResult').innerHTML = '<span style="color:#27AE60;">已创建 ✓（ID: ' + esc(d.vid) + '），正在刷新图谱…</span>';
        setTimeout(()=>{ load(); closeDetail(); }, 1200);
      }
    } else {
      document.getElementById('addResult').innerHTML = '<span style="color:#C0392B;">创建失败：' + esc(d.error||'') + '</span>';
      btn.textContent = '创建节点'; btn.disabled = false;
    }
  } catch(e){
    document.getElementById('addResult').innerHTML = '<span style="color:#C0392B;">创建失败：' + esc(e.message) + '</span>';
    btn.textContent = '创建节点'; btn.disabled = false;
  }
}

// ===== AI 提取 =====
function openExtract(){
  const title = document.getElementById('dTitle');
  const body = document.getElementById('dBody');
  const detail = document.getElementById('detail');
  const backdrop = document.getElementById('backdrop');
  title.textContent = '🤖 AI 提取知识';
  detail.classList.add('open'); backdrop.style.display='block';
  let html = '<div class="empty" style="margin-bottom:10px;">粘贴一段技术资讯/论文摘要/专利说明，AI 会自动提取领域、技术点、支撑材料并入库，图谱自动刷新。</div>';
  html += '<h4>📋 资讯标题（选填）</h4>';
  html += '<input type="text" id="extTitle" placeholder="如：比亚迪第五代DM混动技术" style="width:100%;padding:6px 8px;"/>';
  html += '<h4>📝 资讯内容</h4>';
  html += '<textarea id="extText" rows="10" placeholder="在此粘贴技术资讯全文…" style="width:100%;padding:8px;font-size:13px;line-height:1.6;"></textarea>';
  html += '<div class="note-tip" style="margin-top:4px;">内容越长提取越准，建议 200 字以上</div>';
  html += '<div style="margin-top:10px;display:flex;gap:16px;align-items:center;flex-wrap:wrap;">';
  html += '<label style="font-size:13px;"><input type="checkbox" id="extPreview" /> 仅预览（不入库）</label>';
  html += '<label style="font-size:13px;"><input type="checkbox" id="extTranslate" /> 翻译为中文</label>';
  html += '</div>';
  html += '<button class="save-btn" id="extBtn" onclick="submitExtract(this)" style="margin-top:12px;background:#8E44AD;">🤖 开始提取</button>';
  html += '<div id="extResult" style="margin-top:10px;"></div>';
  body.innerHTML = html;
}

async function submitExtract(btn){
  const text = document.getElementById('extText').value.trim();
  if (!text || text.length < 10){
    document.getElementById('extResult').innerHTML = '<span style="color:#C0392B;">请输入至少 10 字的资讯内容</span>';
    return;
  }
  const title = document.getElementById('extTitle').value.trim();
  const preview = document.getElementById('extPreview').checked;
  const translate = document.getElementById('extTranslate').checked;
  const save = !preview;
  btn.textContent = '🤖 AI 提取中…（约 10-30 秒）'; btn.disabled = true;
  document.getElementById('extResult').innerHTML = '<span style="color:#8E44AD;">⏳ 正在调用大模型分析文本，请稍候…</span>';
  try {
    const res = await fetch('/api/extract', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: text, title: title, save: save, translate: translate })
    });
    const d = await res.json();
    if (d.error){
      document.getElementById('extResult').innerHTML = '<span style="color:#C0392B;">❌ ' + esc(d.error) + '</span>';
      btn.textContent = '🤖 开始提取'; btn.disabled = false;
      return;
    }
    // 展示提取结果
    const ex = d.extracted || {};
    const sv = d.saved || {};
    let html = '<div style="background:#f0f3f7;border-radius:8px;padding:12px;margin-top:8px;">';
    html += '<h4 style="margin:0 0 8px;color:#1B3A5C;">✅ 提取结果</h4>';
    html += '<div class="kv"><b>领域</b><span>' + esc(ex.domain||'-') + '</span></div>';
    html += '<div class="kv"><b>子领域</b><span>' + esc(ex.subdomain||'-') + '</span></div>';
    if (ex.tech_points && ex.tech_points.length){
      html += '<div class="kv"><b>技术点</b><span>' + ex.tech_points.map(t=>esc(t.name)).join('、') + '</span></div>';
    }
    if (ex.materials && ex.materials.length){
      html += '<div class="kv"><b>支撑材料</b><span>' + ex.materials.map(m=>'['+m.type+'] '+esc(m.name)).join('；') + '</span></div>';
    }
    if (sv.edges && sv.edges.length){
      html += '<div class="kv"><b>建立关联</b><span>' + sv.edges.map(e=>esc(e)).join('；') + '</span></div>';
    }
    html += '</div>';
    if (save){
      html += '<div style="margin-top:8px;color:#27AE60;">✓ 已写入数据库，图谱将在 2 秒后刷新…</div>';
    } else {
      html += '<div style="margin-top:8px;color:#8E44AD;">📋 仅预览模式，未写入数据库</div>';
    }
    document.getElementById('extResult').innerHTML = html;
    btn.textContent = '🤖 再次提取'; btn.disabled = false;
    if (save){
      setTimeout(()=>{ load(); closeDetail(); }, 2000);
    }
  } catch(e){
    document.getElementById('extResult').innerHTML = '<span style="color:#C0392B;">❌ 提取失败：' + esc(e.message) + '</span>';
    btn.textContent = '🤖 开始提取'; btn.disabled = false;
  }
}

document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeDetail(); });

function fit(){ if(window.__fit){ window.__fit(); } }
function toggleLabels(){ labelsHidden = !labelsHidden; }

load().catch(err => { loadmsg.innerHTML = '加载失败：' + err.message; });
</script>
</body>
</html>
"""
