from fastapi import APIRouter, Request
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
from backend.services.graph_store import get_store

router = APIRouter(prefix="/graph", tags=["图谱可视化"])
kb = get_store()

# 支撑材料类型（仅 level=0 节点使用）—— 浅色，与技术层深色区分
GROUP_STYLE = {
    "paper":   {"name": "论文",     "color": "#A8C5E0"},  # 浅蓝
    "patent":  {"name": "专利",     "color": "#C9A8E0"},  # 浅紫
    "news":    {"name": "新闻资讯", "color": "#A8E0C5"},  # 浅绿
    "doc":     {"name": "公司技术文件", "color": "#E0C5A8"},  # 浅橙
}

# 技术层（level>=1）按层级着色 —— 深色
LEVEL_COLORS = {
    1: "#1B3A5C",  # 最深蓝
    2: "#2C5F8A",  # 中蓝
    3: "#3a7ab5",  # 较浅蓝
    4: "#4a90d0",  # 更浅
    5: "#5aa5e0",  # 最浅
}

EDGE_LABEL = {
    "belongs_to": "属于", "contains": "包含", "relates_to": "相关",
    "has_standard": "对应标准", "has_patent": "对应专利",
    "references": "挂载资源", "implements": "实现",
    "depends_on": "依赖", "derived_from": "来源于",
    "part_of": "隶属于", "supports": "支撑",
}

# 层级含义：数字越小层级越高（1=最顶层概括，2=子领域，3+ = 更细技术点，0=支撑材料）
# 层级由用户自由编辑，不存在固定映射；默认值按 tag 推断
DEFAULT_LEVEL_BY_TAG = {
    "category": 1, "technology": 2,
    "standard": 0, "patent": 0, "component": 0,
    "resource": 0, "document": 0,
}

# 旧 tag 到新支撑材料类型的映射（兼容种子数据）
LEGACY_TAG_TO_MATERIAL = {
    "standard": "paper", "patent": "patent", "resource": "news",
    "document": "doc", "component": "doc",
}

EDGE_LABEL = {
    "belongs_to": "属于", "contains": "包含", "relates_to": "相关",
    "has_standard": "对应标准", "has_patent": "对应专利",
    "references": "挂载资源", "implements": "实现",
    "depends_on": "依赖", "derived_from": "来源于",
    "part_of": "隶属于", "supports": "支撑",
}

# 层级含义：数字越小层级越高（1=最顶层概括，2=子领域，3+ = 更细技术点，0=支撑材料）
# 层级由用户自由编辑，不存在固定映射；默认值按 tag 推断
DEFAULT_LEVEL_BY_TAG = {
    "category": 1, "technology": 2,
    "standard": 0, "patent": 0, "component": 0,
    "resource": 0, "document": 0,
}


@router.get("/data", summary="获取全图数据（节点+边+颜色+材料类型）")
def graph_data():
    nodes = []
    edges = []

    for v in kb.query_vertices():
        props = v.get("props", {})
        tag = v.get("tag", "unknown")
        label = props.get("name") or props.get("title") or props.get("code") or v.get("vid", "")
        level = props.get("level", DEFAULT_LEVEL_BY_TAG.get(tag, 2))

        # 着色逻辑：level>=1 技术层按层级深色；level=0 支撑材料按材料类型浅色
        if level >= 1:
            group = "level_" + str(level)
            color = LEVEL_COLORS.get(level, LEVEL_COLORS.get(5, "#5aa5e0"))
            material_type = ""
        else:
            # 支撑材料：用 material_type prop 或旧 tag 映射
            material_type = props.get("material_type", LEGACY_TAG_TO_MATERIAL.get(tag, "doc"))
            group = material_type
            color = GROUP_STYLE.get(material_type, {}).get("color", "#E0C5A8")

        title_parts = []
        for k in ["name", "code", "description", "type", "department", "applicant"]:
            if props.get(k):
                title_parts.append(f"{k}: {props.get(k)}")
        title = "<br/>".join(title_parts[:6])

        # 获取备注（用于前端搜索匹配）
        notes_data = kb.get_notes(v["vid"]) if hasattr(kb, "get_notes") else {"remarks": "", "links": ""}

        nodes.append({
            "id": v["vid"],
            "label": label,
            "title": title,
            "group": group,
            "tag": tag,
            "color": color,
            "level": level,
            "material_type": material_type,
            "remarks": notes_data.get("remarks", ""),
        })

    for e in kb.query_edges():
        eprops = e.get("props", {}) or {}
        edges.append({
            "id": e.get("id"),
            "from": e["src_vid"],
            "to": e["dst_vid"],
            "edge_type": e["edge_type"],
            "label": EDGE_LABEL.get(e["edge_type"], e["edge_type"]),
            "remark": eprops.get("remark", ""),
            "title": eprops.get("remark", "") or EDGE_LABEL.get(e["edge_type"], e["edge_type"]),
        })

    # 动态构建 group_style：固定 4 种 + 节点上出现的自定义材料类型
    custom_palette = ["#B0B0B0", "#D8B0A0", "#A0B8D8", "#C8B8D8", "#B8D8C8", "#D8D8A0"]
    group_style = dict(GROUP_STYLE)
    custom_idx = 0
    seen = set(GROUP_STYLE.keys())
    for n in nodes:
        if n["level"] == 0 and n["material_type"] and n["material_type"] not in seen:
            seen.add(n["material_type"])
            group_style[n["material_type"]] = {
                "name": n["material_type"],
                "color": custom_palette[custom_idx % len(custom_palette)],
                "custom": True,
            }
            custom_idx += 1

    return {"nodes": nodes, "edges": edges, "group_style": group_style, "level_colors": LEVEL_COLORS}


@router.get("/node/{vid}", summary="获取节点详情（含关联子图+备注+材料）")
def node_detail(vid: str):
    node = kb.get_vertex(vid)
    if not node:
        return {"error": "not found"}

    props = node.get("props", {})
    tag = node.get("tag", "unknown")
    label = props.get("name") or props.get("title") or props.get("code") or vid

    relations = []
    for e in kb.query_edges(src_vid=vid):
        is_src = (e["src_vid"] == vid)
        other_vid = e["dst_vid"] if is_src else e["src_vid"]
        other = kb.get_vertex(other_vid)
        other_props = other.get("props", {}) if other else {}
        other_label = other_props.get("name") or other_props.get("title") or other_props.get("code") or other_vid
        other_tag = other.get("tag", "unknown") if other else "unknown"
        eprops = e.get("props", {}) or {}
        relations.append({
            "edge_type": e["edge_type"],
            "relation_name": EDGE_LABEL.get(e["edge_type"], e["edge_type"]),
            "direction": "out" if is_src else "in",
            "src_vid": e["src_vid"],
            "dst_vid": e["dst_vid"],
            "target_vid": other_vid,
            "target_label": other_label,
            "target_tag": other_tag,
            "target_type_name": GROUP_STYLE.get(other_tag, {}).get("name", other_tag),
            "edge_remark": eprops.get("remark", ""),
        })

    self_rels = [r for r in relations if r["direction"] == "in"]
    out_rels = [r for r in relations if r["direction"] == "out"]

    notes = kb.get_notes(vid) if hasattr(kb, "get_notes") else {"remarks": "", "links": "", "updated_at": None}
    default_level = props.get("level", DEFAULT_LEVEL_BY_TAG.get(tag, 2))
    material_type = props.get("material_type", LEGACY_TAG_TO_MATERIAL.get(tag, "doc"))
    if default_level >= 1:
        node_color = LEVEL_COLORS.get(default_level, LEVEL_COLORS.get(5, "#5aa5e0"))
    else:
        node_color = GROUP_STYLE.get(material_type, {}).get("color", "#E0C5A8")

    # all_materials：固定 4 种 + 全库已出现的自定义材料类型
    custom_palette = ["#B0B0B0", "#D8B0A0", "#A0B8D8", "#C8B8D8", "#B8D8C8", "#D8D8A0"]
    all_materials = dict(GROUP_STYLE)
    seen_m = set(GROUP_STYLE.keys())
    ci = 0
    for v in kb.query_vertices():
        vp = v.get("props", {})
        if vp.get("level", DEFAULT_LEVEL_BY_TAG.get(v.get("tag", ""), 2)) == 0:
            mt = vp.get("material_type", LEGACY_TAG_TO_MATERIAL.get(v.get("tag", ""), "doc"))
            if mt and mt not in seen_m:
                seen_m.add(mt)
                all_materials[mt] = {"name": mt, "color": custom_palette[ci % len(custom_palette)], "custom": True}
                ci += 1

    return {
        "vid": vid,
        "label": label,
        "tag": tag,
        "tag_name": GROUP_STYLE.get(material_type, {}).get("name", tag) if default_level == 0 else ("层级" + str(default_level)),
        "color": node_color,
        "level": default_level,
        "material_type": material_type,
        "props": props,
        "out_relations": out_rels,
        "in_relations": self_rels,
        "notes": notes,
        "all_materials": all_materials,
        "all_edge_types": EDGE_LABEL,
        "level_colors": LEVEL_COLORS,
    }


class NodeEdit(BaseModel):
    label: str = ""
    level: int = 0
    material_type: str = ""
    remarks: str = ""
    links: str = ""


@router.post("/node/{vid}/edit", summary="编辑节点（名称/层级/材料类型/备注/链接）")
def edit_node(vid: str, body: NodeEdit):
    node = kb.get_vertex(vid)
    if not node:
        return {"error": "not found"}
    props = dict(node.get("props", {}))
    # 更新 label
    if body.label:
        if "name" in props:
            props["name"] = body.label
        elif "title" in props:
            props["title"] = body.label
        else:
            props["name"] = body.label
    # 更新 level
    props["level"] = body.level
    # 更新 material_type（level=0 时写入用户选择/自定义；level>=1 时清空）
    if body.level == 0 and body.material_type:
        props["material_type"] = body.material_type
    elif body.level >= 1:
        props["material_type"] = ""
    # tag 保留原值（不再用于着色）
    new_tag = node.get("tag", "technology")
    # 写入 props
    if hasattr(kb, "update_vertex"):
        kb.update_vertex(vid, tag=new_tag, props=props)
    else:
        kb.insert_vertex(new_tag, vid, props)
    # 同步更新备注
    if hasattr(kb, "update_notes") and (body.remarks or body.links):
        kb.update_notes(vid, body.remarks, body.links)
    return {"ok": True, "vid": vid, "level": body.level, "material_type": props.get("material_type", "")}


# ===== 手动添加节点 =====
class NodeCreate(BaseModel):
    label: str = ""
    level: int = 2
    material_type: str = ""
    remarks: str = ""
    links: str = ""
    parent_vid: str = ""   # 可选：创建后自动连一条边到父节点
    edge_type: str = "relates_to"


@router.post("/node/create", summary="添加新节点（可自动连父节点）")
def create_node(body: NodeCreate):
    if not body.label.strip():
        return {"error": "label 不能为空"}
    # 生成唯一 vid
    import uuid
    vid = "node_" + uuid.uuid4().hex[:10]
    # tag：level=0 用 material_type 或 "material"，level>=1 用 "technology"
    if body.level == 0:
        tag = "material"
    else:
        tag = "technology"
    props = {"name": body.label.strip(), "level": body.level}
    if body.level == 0 and body.material_type:
        props["material_type"] = body.material_type
    kb.insert_vertex(tag, vid, props)
    # 备注
    if hasattr(kb, "update_notes") and (body.remarks or body.links):
        kb.update_notes(vid, body.remarks, body.links)
    # 自动连线到父节点
    if body.parent_vid:
        parent = kb.get_vertex(body.parent_vid)
        if parent:
            kb.insert_edge(body.edge_type, body.parent_vid, vid, {})
    return {"ok": True, "vid": vid, "label": body.label.strip(), "level": body.level}


# ===== 连线（边）管理 =====
class EdgeCreate(BaseModel):
    src_vid: str
    dst_vid: str
    edge_type: str = "relates_to"
    remark: str = ""


class EdgeDelete(BaseModel):
    src_vid: str
    dst_vid: str
    edge_type: str


class EdgeEdit(BaseModel):
    src_vid: str
    dst_vid: str
    edge_type: str
    remark: str = ""


@router.post("/edge/add", summary="添加边（连线）")
def add_edge(body: EdgeCreate):
    if not kb.get_vertex(body.src_vid) or not kb.get_vertex(body.dst_vid):
        return {"error": "源节点或目标节点不存在"}
    eid = kb.insert_edge(body.edge_type, body.src_vid, body.dst_vid, {"remark": body.remark} if body.remark else None)
    return {"ok": True, "edge_type": body.edge_type, "src": body.src_vid, "dst": body.dst_vid}


@router.post("/edge/delete", summary="删除边（连线）")
def remove_edge(body: EdgeDelete):
    ok = kb.delete_edge(body.edge_type, body.src_vid, body.dst_vid)
    return {"ok": ok}


@router.post("/edge/edit", summary="编辑边备注")
def edit_edge(body: EdgeEdit):
    ok = kb.update_edge(body.edge_type, body.src_vid, body.dst_vid, {"remark": body.remark})
    return {"ok": ok}


@router.delete("/node/{vid}", summary="删除节点（连带删除所有相关边和备注）")
def delete_node(vid: str):
    node = kb.get_vertex(vid)
    if not node:
        return {"error": "节点不存在"}
    label = node["props"].get("name", vid)
    if hasattr(kb, "delete_vertex"):
        ok = kb.delete_vertex(vid)
    else:
        return {"error": "当前引擎不支持删除节点"}
    return {"ok": ok, "vid": vid, "label": label}


class NotesUpdate(BaseModel):
    remarks: str = ""
    links: str = ""


@router.post("/node/{vid}/notes", summary="保存节点备注")
def save_node_notes(vid: str, body: NotesUpdate):
    if not hasattr(kb, "update_notes"):
        return {"error": "当前引擎不支持备注保存"}
    result = kb.update_notes(vid, body.remarks, body.links)
    return {"ok": True, "notes": result}


@router.get("", response_class=HTMLResponse, summary="图谱可视化页面")
def graph_page():
    html = _render()
    return HTMLResponse(html)


def _render():
    return """
