<script>
const loadmsg = document.getElementById('loadmsg');
let NODES = [], EDGES = [], COLORS = {};
const MATERIAL_NAMES = { paper:'论文', patent:'专利', news:'新闻资讯', doc:'公司技术文件' };
const EDGE_LABELS = {
  "belongs_to": "属于", "contains": "包含", "relates_to": "相关",
  "has_standard": "对应标准", "has_patent": "对应专利",
  "references": "挂载资源", "implements": "实现",
  "depends_on": "依赖", "derived_from": "来源于",
  "part_of": "隶属于", "supports": "支撑",
};
// 布局状态
let nodes = [], links = [];
let view = { cx: 0, cy: 0, scale: 1 };
let dragId = null, dragState = null, panning = false, lastPos = null, moved = false;
let labelsHidden = false;
// 物理与模式
let physicsOn = true;
let layoutMode = 'force';
let settleTimer = null;
// 选中高亮
let selectedId = null;
let neighborSet = new Set();
// 搜索高亮
let searchTerm = '';
let searchMatchSet = new Set();
// 层级筛选
let filterLevel = '';
// 折叠：双击节点收起其下一层子节点
let collapsedSet = new Set();
let pendingClickTimer = null;

// 计算被折叠隐藏的节点集合
// 规则：L0 支撑材料只有当它支撑的所有技术点都被折叠时才隐藏
// 搜索匹配的节点不被隐藏
function getHiddenNodes(){
  const hidden = new Set();
  const hasSearch = searchTerm.length > 0;
  for (const n of nodes){
    if (n.level > 0) continue;
    if (hasSearch && searchMatchSet.has(n.id)) continue;
    let hasTechLink = false;
    let allTechCollapsed = true;
    for (const l of links){
      if (l.source.id === n.id && l.label === '支撑' && l.target.level >= 1){
        hasTechLink = true;
        if (!collapsedSet.has(l.target.id)){
          allTechCollapsed = false;
          break;
        }
      }
    }
    if (hasTechLink && allTechCollapsed){
      hidden.add(n.id);
    }
  }
  return hidden;
}

// 缓存 hiddenSet，避免每帧重复计算
let _cachedHiddenSet = null;
let _cachedHiddenSig = '';
function getCachedHidden(){
  const sig = searchTerm + '|' + [...collapsedSet].sort().join(',');
  if (sig !== _cachedHiddenSig){
    _cachedHiddenSet = getHiddenNodes();
    _cachedHiddenSig = sig;
  }
  return _cachedHiddenSet;
}
function invalidateHiddenCache(){ _cachedHiddenSet = null; _cachedHiddenSig = ''; }

// 统计某技术点节点的 L0 支撑材料数量
// 边方向：material(source, L0) → tech_point(target, L3)
function countMaterials(vid){
  let c = 0;
  for (const l of links){
    if (l.target.id === vid && l.source.level <= 0 && l.label === '支撑') c++;
  }
  return c;
}

function esc(s){
  s = (s===null||s===undefined)?'':String(s);
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// 层级 → 球半径映射：level 越小球越大（1=最顶层最大，数字越大越细越小，0=支撑材料最小）
function radiusForLevel(level){
  if (level <= 0) return 8;       // 支撑材料
  return Math.max(8, 26 - level * 4);  // 1→22, 2→18, 3→14, 4→10, 5+→8
}

async function load() {
  try {
    const res = await fetch('/graph/data');
    const data = await res.json();
    COLORS = {};
    // 支撑材料颜色
    for (const [g, info] of Object.entries(data.group_style || {})) { COLORS[g] = info.color; }
    // 层级颜色
    const LVC = data.level_colors || {};
    for (const [lv, col] of Object.entries(LVC)) { COLORS['level_' + lv] = col; }
    NODES = data.nodes; EDGES = data.edges;

    // 初始化节点物理位置（半径按层级，同层同大小；颜色由后端给定）
    nodes = NODES.map(n => ({
      id: n.id, label: n.label, group: n.group, color: n.color || '#2C5F8A',
      level: n.level || 0, material_type: n.material_type || '',
      remarks: n.remarks || '',
      x: (Math.random()-0.5)*400, y: (Math.random()-0.5)*300,
      vx: 0, vy: 0, r: radiusForLevel(n.level || 0),
      collapsed: false
    }));
    const idmap = {}; nodes.forEach(n => idmap[n.id] = n);
    links = EDGES.filter(e => idmap[e.from] && idmap[e.to]).map(e => ({
      source: idmap[e.from], target: idmap[e.to], label: e.label || '', remark: e.remark || ''
    }));

    // 默认折叠：所有 L3 技术点节点收起其 L0 支撑材料
    collapsedSet = new Set();
    for (const n of nodes){
      if (n.level >= 3) collapsedSet.add(n.id);
    }
    invalidateHiddenCache();

    setupCanvas();

    // 加载后自动拉伸 2.5 秒后停止 physics（减少持续 CPU 占用）
    physicsOn = true;
    if (settleTimer) clearTimeout(settleTimer);
    settleTimer = setTimeout(()=>{ physicsOn = false; }, 2500);

    // 图例 + 筛选：从当前 nodes 动态渲染
    renderLegend();
    document.getElementById('stats').innerHTML =
      '共 <b>' + data.nodes.length + '</b> 个节点，<b>' + data.edges.length + '</b> 条关系';
    refreshLevelFilter(data.nodes);
    loadmsg.style.display = 'none';
  } catch(err) {
    loadmsg.innerHTML = '加载失败：' + err.message + ' <br>请按 F12 查看控制台错误，或 Ctrl+F5 强制刷新';
    console.error('load() error:', err);
  }
}

// 渲染图例：从 nodes 收集实际出现的层级和材料类型
function renderLegend(){
  const legend = document.getElementById('legend');
  // 收集层级（>=1）
  const levelSet = new Set();
  const matMap = {};  // material_type -> color
  for (const n of nodes){
    if ((n.level||0) >= 1) levelSet.add(n.level);
    else if (n.material_type) matMap[n.material_type] = n.color;
  }
  const levels = [...levelSet].sort((a,b)=>a-b);
  let html = '<div style="font-size:11px;color:#888;margin:6px 0 2px;">技术层</div>';
  for (const lv of levels){
    const col = COLORS['level_' + lv] || '#5aa5e0';
    html += '<div class="legend-item"><span class="dot" style="background:' + col + '"></span>层级 ' + lv + '</div>';
  }
  html += '<div style="font-size:11px;color:#888;margin:8px 0 2px;">支撑材料（level 0）</div>';
  // 固定 4 种 + 自定义
  const order = ['paper','patent','news','doc'];
  const shown = new Set();
  for (const mt of order){
    if (COLORS[mt]){
      html += '<div class="legend-item"><span class="dot" style="background:' + COLORS[mt] + '"></span>' + (MATERIAL_NAMES[mt]||mt) + '</div>';
      shown.add(mt);
    }
  }
  for (const [mt, col] of Object.entries(matMap)){
    if (shown.has(mt)) continue;
    html += '<div class="legend-item"><span class="dot" style="background:' + col + '"></span>' + mt + '</div>';
  }
  legend.innerHTML = html;
}

// 刷新层级筛选下拉（编辑层级后也要调用）
function refreshLevelFilter(nodeList){
  const lf = document.getElementById('levelFilter');
  const curVal = lf.value;
  const levels = [...new Set(nodeList.map(n => n.level || 0))].sort((a,b)=>a-b);
  lf.innerHTML = '<option value="">全部层级</option>';
  for (const lv of levels){
    lf.innerHTML += '<option value="' + lv + '"' + (String(lv)===curVal?' selected':'') + '>层级 ' + lv + (lv===0?' (支撑材料)':'') + '</option>';
  }
}

function setupCanvas(){
  const holder = document.getElementById('canvas');
  holder.innerHTML = '';
  const cv = document.createElement('canvas');
  cv.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;cursor:grab;';
  holder.appendChild(cv);
  const ctx = cv.getContext('2d');
  const dpr = window.devicePixelRatio || 1;

  function resize(){
    const R = holder.getBoundingClientRect();
    cv.width = R.width*dpr; cv.height = R.height*dpr;
    cv.style.width = R.width+'px'; cv.style.height = R.height+'px';
  }
  resize(); window.addEventListener('resize', resize);

  function toScreen(x, y){ return { x: x*view.scale + view.cx, y: y*view.scale + view.cy }; }
  function toWorld(x, y){ return { x: (x-view.cx)/view.scale, y: (y-view.cy)/view.scale }; }
  function hitTest(px, py){
    for (let i=nodes.length-1;i>=0;i--){
      const s = toScreen(nodes[i].x, nodes[i].y);
      if (Math.hypot(px-s.x, py-s.y) <= (nodes[i].r+4)*view.scale) return nodes[i];
    }
    return null;
  }

  function step(){
    // 力导向：斥力 + 弹簧 + 向心力 + 阻尼
    const RE = 900, K = 0.02, C = 400, DAMP = 0.85;
    const hiddenSet = getCachedHidden();
    // 只对可见节点做斥力计算（大幅减少 O(n²) 运算量）
    const visNodes = nodes.filter(n => !hiddenSet.has(n.id));
    for (let i=0;i<visNodes.length;i++){
      for (let j=i+1;j<visNodes.length;j++){
        const a=visNodes[i], b=visNodes[j];
        let dx=a.x-b.x, dy=a.y-b.y;
        let d=Math.hypot(dx,dy)||1;
        let f=RE/(d*d);
        let fx=dx/d*f, fy=dy/d*f;
        a.vx+=fx; a.vy+=fy; b.vx-=fx; b.vy-=fy;
      }
    }
    // 弹簧力也跳过隐藏节点
    for (const l of links){
      if (hiddenSet.has(l.source.id) || hiddenSet.has(l.target.id)) continue;
      const a=l.source, b=l.target;
      const dx=b.x-a.x, dy=b.y-a.y;
      const d=Math.hypot(dx,dy)||1;
      const f=K*(d-120);
      const fx=dx/d*f, fy=dy/d*f;
      a.vx+=fx; a.vy+=fy; b.vx-=fx; b.vy-=fy;
    }
    // 位移也只对可见节点
    for (const n of visNodes){
      // 被拖动的节点不参与位移
      if (n === dragId && dragState==='node') continue;
      n.vx += (0-n.x)*0.003; n.vy += (0-n.y)*0.003;
      n.vx *= DAMP; n.vy *= DAMP;
      n.x += n.vx; n.y += n.vy;
    }
  }

  function draw(){
    ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.clearRect(0,0,cv.width/dpr,cv.height/dpr);

    const hasSel = !!selectedId;
    const hasSearch = searchTerm.length > 0;
    const hasFilter = filterLevel !== '';
    const hiddenSet = getCachedHidden();

    // 边
    ctx.lineWidth = 1.3;
    for (const l of links){
      if (hiddenSet.has(l.source.id) || hiddenSet.has(l.target.id)) continue;
      const a=toScreen(l.source.x,l.source.y), b=toScreen(l.target.x,l.target.y);
      let active = true;
      let highlightColor = null;
      if (hasSel){
        active = (l.source.id===selectedId || l.target.id===selectedId);
        if (active) highlightColor = '#7a8a99';
      } else if (hasSearch){
        active = (searchMatchSet.has(l.source.id) && searchMatchSet.has(l.target.id));
        if (active) highlightColor = '#E86C00';
      } else if (hasFilter){
        // 筛选模式：选中层级节点清晰，连线和相关节点半透明（不喧宾夺主）
        const srcMatch = (l.source.level === filterLevel);
        const dstMatch = (l.target.level === filterLevel);
        if (srcMatch || dstMatch){
          active = true;
          highlightColor = null;  // 不高亮连线颜色
        } else {
          active = false;
        }
      }
      // 筛选模式下，连线用较低透明度（0.22），不像选中态那样全亮
      if (hasFilter && active){
        ctx.globalAlpha = 0.22;
        ctx.strokeStyle = '#7a8a99';
        ctx.lineWidth = 1;
      } else {
        ctx.globalAlpha = active ? 1 : 0.06;
        ctx.strokeStyle = active ? (highlightColor || '#7a8a99') : '#b7c3cf';
        if (active) { ctx.lineWidth = 2; } else { ctx.lineWidth = 1; }
      }
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
      // 箭头
      const ang=Math.atan2(b.y-a.y,b.x-a.x), r=l.source.r*view.scale+6;
      const hx=b.x-Math.cos(ang)*6, hy=b.y-Math.sin(ang)*6;
      ctx.fillStyle = active ? (highlightColor || '#5a6a78') : '#9aa7b4';
      ctx.beginPath();
      ctx.moveTo(hx+Math.cos(ang)*5, hy+Math.sin(ang)*5);
      ctx.lineTo(hx+Math.cos(ang+2.5)*5, hy+Math.sin(ang+2.5)*5);
      ctx.lineTo(hx+Math.cos(ang-2.5)*5, hy+Math.sin(ang-2.5)*5);
      ctx.closePath(); ctx.fill();
      // 选中态：在线上绘制边的标签（关系名+备注）
      if (active && hasSel && (l.label || l.remark)){
        const mx=(a.x+b.x)/2, my=(a.y+b.y)/2;
        const labelText = l.remark ? (l.label + ' | ' + l.remark) : l.label;
        if (labelText){
          ctx.font='11px "Microsoft YaHei"';
          const tw=ctx.measureText(labelText).width;
          ctx.fillStyle='rgba(255,255,255,.85)';
          ctx.fillRect(mx-tw/2-3, my-8, tw+6, 16);
          ctx.fillStyle='#1B3A5C';
          ctx.textAlign='center'; ctx.textBaseline='middle';
          ctx.fillText(labelText, mx, my);
          ctx.textBaseline='alphabetic';
        }
      }
    }
    ctx.lineWidth = 1.3;

    // 节点
    for (const n of nodes){
      if (hiddenSet.has(n.id)) continue;
      const s=toScreen(n.x,n.y), r=n.r*view.scale;
      let active = true;
      let hlColor = null;
      if (hasSel){
        active = (n.id===selectedId || neighborSet.has(n.id));
      } else if (hasSearch){
        active = searchMatchSet.has(n.id);
        if (active) hlColor = '#E86C00';
      } else if (hasFilter){
        // 筛选模式：选中层级节点清晰，其他节点半透明
        if (n.level === filterLevel){
          active = true;
          hlColor = '#2C5F8A';
        } else {
          // 检查是否与选中层级节点相连
          let connected = false;
          for (const l of links){
            if ((l.source.id === n.id && l.target.level === filterLevel) ||
                (l.target.id === n.id && l.source.level === filterLevel)){
              connected = true;
              break;
            }
          }
          active = connected;
        }
      }
      // 筛选模式下：非选中层级但相连的节点用半透明（0.35），比支撑材料亮但不喧宾夺主
      if (hasFilter && active && n.level !== filterLevel){
        ctx.globalAlpha = 0.35;
      } else if (hasFilter && !active){
        ctx.globalAlpha = 0.08;
      } else {
        ctx.globalAlpha = active ? 1 : 0.12;
      }
      ctx.beginPath(); ctx.arc(s.x,s.y,r,0,Math.PI*2);
      ctx.fillStyle=n.color; ctx.fill();
      ctx.lineWidth = (n.id===selectedId) ? 4 : (active && hlColor ? 3 : 2);
      ctx.strokeStyle = (n.id===selectedId) ? '#E86C00' : (active && hlColor ? hlColor : '#1B3A5C');
      ctx.stroke();
      if(!labelsHidden){
        // 标签透明度按层级分层：
        // L1(领域) 90% / L2(子领域) 70% / L3(技术点) 35% / L0(支撑材料) 6%
        let labelAlpha, labelSize, labelColor;
        if (n.id === selectedId){
          labelAlpha = 1; labelSize = 'bold 14px "Microsoft YaHei"'; labelColor = hlColor || '#E86C00';
        } else if (active && hlColor){
          labelAlpha = 1; labelSize = 'bold 13px "Microsoft YaHei"'; labelColor = hlColor;
        } else if (hasSel){
          // 有选中节点时：邻居节点高亮，其余很淡
          if (neighborSet.has(n.id)){
            labelAlpha = 0.9; labelSize = '13px "Microsoft YaHei"'; labelColor = '#333';
          } else {
            labelAlpha = 0.08; labelSize = '11px "Microsoft YaHei"'; labelColor = '#999';
          }
        } else if (hasFilter){
          // 筛选模式：选中层级标签清晰，相连节点标签半透明，其余几乎不显示
          if (n.level === filterLevel){
            labelAlpha = 0.9; labelSize = 'bold 13px "Microsoft YaHei"'; labelColor = '#1B3A5C';
          } else if (active){
            labelAlpha = 0.3; labelSize = '11px "Microsoft YaHei"'; labelColor = '#555';
          } else {
            labelAlpha = 0.05; labelSize = '10px "Microsoft YaHei"'; labelColor = '#999';
          }
        } else {
          // 无选中：按层级显示
          if (n.level === 1){ labelAlpha = 0.9; labelSize = 'bold 13px "Microsoft YaHei"'; labelColor = '#1B3A5C'; }
          else if (n.level === 2){ labelAlpha = 0.7; labelSize = '12px "Microsoft YaHei"'; labelColor = '#333'; }
          else if (n.level === 3){ labelAlpha = 0.35; labelSize = '11px "Microsoft YaHei"'; labelColor = '#555'; }
          else { labelAlpha = 0.06; labelSize = '10px "Microsoft YaHei"'; labelColor = '#999'; }
        }
        ctx.globalAlpha = labelAlpha;
        ctx.fillStyle = labelColor;
        ctx.font = labelSize;
        ctx.textAlign='center'; ctx.fillText(n.label, s.x, s.y+r+14);
      }
      // 折叠指示器：直接在球面显示支撑材料数量（白色数字，无橙色圆）
      if (collapsedSet.has(n.id)){
        const matCount = countMaterials(n.id);
        if (matCount > 0){
          ctx.globalAlpha = 0.95;
          ctx.fillStyle = '#fff';
          ctx.font = 'bold ' + Math.max(10, Math.round(r*0.85)) + 'px "Microsoft YaHei"';
          ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.fillText(String(matCount), s.x, s.y);
          ctx.textBaseline = 'alphabetic';
        }
      }
    }
    ctx.globalAlpha = 1;

    if (dragId && dragState==='node'){
      const d=toScreen(dragId.x,dragId.y);
      ctx.beginPath(); ctx.arc(d.x,d.y,(dragId.r+6)*view.scale,0,Math.PI*2);
      ctx.strokeStyle='#E86C00'; ctx.lineWidth=2; ctx.stroke();
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }

  // 交互
  cv.addEventListener('mousedown', e=>{
    const rect=cv.getBoundingClientRect();
    const px=e.clientX-rect.left, py=e.clientY-rect.top;
    const n=hitTest(px,py);
    lastPos={px,py}; moved=false;
    if(n){ dragId=n; dragState='node'; }
    else { panning=true; cv.style.cursor='grabbing'; }
  });
  window.addEventListener('mousemove', e=>{
    const rect=cv.getBoundingClientRect();
    const px=e.clientX-rect.left, py=e.clientY-rect.top;
    if (dragId && dragState==='node'){
      if(Math.hypot(px-lastPos.px,py-lastPos.py)>3) moved=true;
      const w=toWorld(px,py);
      dragId.x=w.x; dragId.y=w.y; dragId.vx=0; dragId.vy=0;
    } else if (panning){
      view.cx+=(px-lastPos.px); view.cy+=(py-lastPos.py);
      moved=true;
    }
    lastPos={px,py};
  });
  window.addEventListener('mouseup', e=>{
    if (dragState==='node' && dragId && !moved){
      const clickId = dragId.id;
      // 延时触发单击行为，给双击留出取消窗口
      pendingClickTimer = setTimeout(()=>{
        selectNode(clickId);
        showDetail(clickId);
      }, 230);
    } else if (panning && !moved){
      // 点击空白处取消高亮
      clearSelect();
    }
    dragId=null; dragState=null; panning=false; cv.style.cursor='grab';
  });
  cv.addEventListener('wheel', e=>{
    e.preventDefault();
    const rect=cv.getBoundingClientRect();
    const px=e.clientX-rect.left, py=e.clientY-rect.top;
    const factor=e.deltaY<0?1.1:0.9;
    const w=toWorld(px,py);
    view.scale*=factor;
    view.cx=px-w.x*view.scale; view.cy=py-w.y*view.scale;
  }, {passive:false});

  // 双击节点 → 收起/展开其下一层子节点（取消单击的详情弹出）
  cv.addEventListener('dblclick', e=>{
    if (pendingClickTimer){ clearTimeout(pendingClickTimer); pendingClickTimer = null; }
    const rect=cv.getBoundingClientRect();
    const px=e.clientX-rect.left, py=e.clientY-rect.top;
    const n=hitTest(px,py);
    if(n){
      if (collapsedSet.has(n.id)){
        collapsedSet.delete(n.id);
      } else {
        collapsedSet.add(n.id);
      }
      invalidateHiddenCache();
    }
  });

  view.scale=1; view.cx=0; view.cy=0;

  // 物理 + 绘制主循环
  function loop(){
    if (physicsOn) step();
    draw();
    requestAnimationFrame(loop);
  }
  loop();

  window.__fit = ()=>{
    let minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
    nodes.forEach(n=>{ minX=Math.min(minX,n.x);maxX=Math.max(maxX,n.x);minY=Math.min(minY,n.y);maxY=Math.max(maxY,n.y);});
    const rect=cv.getBoundingClientRect();
    const w=maxX-minX+400,h=maxY-minY+400;
    view.scale=Math.min(rect.width/w, rect.height/h, 1.5);
    view.cx=rect.width/2-((minX+maxX)/2)*view.scale;
    view.cy=rect.height/2-((minY+maxY)/2)*view.scale;
  };
}

// 选中节点：高亮该节点 + 邻居，其余变灰
function selectNode(vid){
  selectedId = vid;
  neighborSet = new Set();
  if (vid){
    for (const l of links){
      if (l.source.id === vid) neighborSet.add(l.target.id);
      else if (l.target.id === vid) neighborSet.add(l.source.id);
    }
  }
}
function clearSelect(){
  selectedId = null;
  neighborSet = new Set();
  // 详情面板中取消当前关联高亮
  document.querySelectorAll('#detail .rel.cur').forEach(el => el.classList.remove('cur'));
}

// 搜索：匹配的节点放入 searchMatchSet，高亮节点+其间连线
function onSearch(val){
  searchTerm = (val || '').trim().toLowerCase();
  searchMatchSet = new Set();
  invalidateHiddenCache();
  if (searchTerm.length === 0) return;
  // 选中态优先级高于搜索，搜索时清空选中
  selectedId = null; neighborSet = new Set();
  for (const n of nodes){
    if (n.label.toLowerCase().indexOf(searchTerm) >= 0 ||
        n.id.toLowerCase().indexOf(searchTerm) >= 0 ||
        (n.remarks && n.remarks.toLowerCase().indexOf(searchTerm) >= 0)){
      searchMatchSet.add(n.id);
    }
  }
}

